{
  "manifest_version": 3,
  "name": "WhatsApp Side Panel Layout",
  "version": "0.2.1",
  "description": "WhatsApp nel pannello laterale: sotto una certa larghezza mostra un pannello alla volta, elenco conversazioni oppure chat, con tasto indietro.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Apri WhatsApp",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "side_panel": { "default_path": "panel.html" },
  "options_ui": { "page": "popup.html", "open_in_tab": false },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["desktop-ua.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
